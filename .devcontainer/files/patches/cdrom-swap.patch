 #define MTD_OPTS ""
 #define SD_OPTS ""
 
+/*
+ * Image lists cycled round-robin by qemu_cdrom_cycle_next(), one per drive:
+ * repeated -cdrom options (drive_id == NULL) and -cdrom-swap drive=ID,file=F.
+ */
+typedef struct CdromSwapList {
+    char *drive_id;
+    char *blk_name;
+    char *format;
+    GPtrArray *files;
+    guint idx;
+} CdromSwapList;
+
+static GPtrArray *cdrom_swap_lists;
+
+static QemuOptsList qemu_cdrom_swap_opts = {
+    .name = "cdrom-swap",
+    .head = QTAILQ_HEAD_INITIALIZER(qemu_cdrom_swap_opts.head),
+    .desc = {
+        { .name = "drive", .type = QEMU_OPT_STRING },
+        { .name = "file", .type = QEMU_OPT_STRING },
+        { /* end of list */ }
+    },
+};
+
+static CdromSwapList *cdrom_swap_list_get(const char *drive_id)
+{
+    CdromSwapList *l;
+    guint i;
+
+    if (!cdrom_swap_lists) {
+        cdrom_swap_lists = g_ptr_array_new();
+    }
+    for (i = 0; i < cdrom_swap_lists->len; i++) {
+        l = g_ptr_array_index(cdrom_swap_lists, i);
+        if (g_strcmp0(l->drive_id, drive_id) == 0) {
+            return l;
+        }
+    }
+    l = g_new0(CdromSwapList, 1);
+    l->drive_id = g_strdup(drive_id);
+    l->files = g_ptr_array_new_with_free_func(g_free);
+    g_ptr_array_add(cdrom_swap_lists, l);
+    return l;
+}
+
+static void cdrom_swap_add_option(const char *optarg)
+{
+    QemuOpts *opts = qemu_opts_parse_noisily(&qemu_cdrom_swap_opts, optarg,
+                                             false);
+    const char *drive, *file;
+
+    if (!opts) {
+        exit(1);
+    }
+    drive = qemu_opt_get(opts, "drive");
+    file = qemu_opt_get(opts, "file");
+    if (!drive || !file) {
+        error_report("-cdrom-swap requires drive=ID,file=FILE");
+        exit(1);
+    }
+    g_ptr_array_add(cdrom_swap_list_get(drive)->files, g_strdup(file));
+    qemu_opts_del(opts);
+}
+
+/* Bind each list to its BlockBackend; called once the drives exist */
+static void cdrom_swap_resolve(BlockInterfaceType block_default_type)
+{
+    guint i;
+
+    for (i = 0; cdrom_swap_lists && i < cdrom_swap_lists->len; i++) {
+        CdromSwapList *l = g_ptr_array_index(cdrom_swap_lists, i);
+        DriveInfo *dinfo;
+        BlockBackend *blk;
+        const char *initial;
+
+        if (l->drive_id) {
+            blk = blk_by_name(l->drive_id);
+            dinfo = blk ? blk_legacy_dinfo(blk) : NULL;
+            if (!dinfo) {
+                error_report("-cdrom-swap: no -drive with id '%s'",
+                             l->drive_id);
+                exit(1);
+            }
+            initial = qemu_opt_get(dinfo->opts, "file");
+            if (initial && *initial) {
+                g_ptr_array_insert(l->files, 0, g_strdup(initial));
+            } else {
+                /* Started empty: the first switch inserts files[0] */
+                l->idx = l->files->len - 1;
+            }
+        } else {
+            dinfo = drive_get_by_index(block_default_type, 2);
+            blk = dinfo ? blk_by_legacy_dinfo(dinfo) : NULL;
+            if (!blk) {
+                error_report("-cdrom: drive not found");
+                exit(1);
+            }
+        }
+        l->blk_name = g_strdup(blk_name(blk));
+        l->format = g_strdup(qemu_opt_get(dinfo->opts, "format"));
+    }
+}
+
+bool qemu_cdrom_cycle_enabled(void)
+{
+    guint i;
+
+    for (i = 0; cdrom_swap_lists && i < cdrom_swap_lists->len; i++) {
+        CdromSwapList *l = g_ptr_array_index(cdrom_swap_lists, i);
+
+        if (l->blk_name && l->files->len > 1) {
+            return true;
+        }
+    }
+    return false;
+}
+
+void qemu_cdrom_cycle_next(void)
+{
+    guint i;
+
+    for (i = 0; cdrom_swap_lists && i < cdrom_swap_lists->len; i++) {
+        CdromSwapList *l = g_ptr_array_index(cdrom_swap_lists, i);
+        const char *file;
+        Error *err = NULL;
+
+        if (!l->blk_name || l->files->len < 2) {
+            continue;
+        }
+
+        /* Advance even on failure so a broken image can be skipped */
+        l->idx = (l->idx + 1) % l->files->len;
+        file = g_ptr_array_index(l->files, l->idx);
+
+        qmp_blockdev_change_medium(l->blk_name, NULL, file, l->format,
+                                   true, true, false, 0, &err);
+        if (err) {
+            error_reportf_err(err, "CD-ROM %s: switch to '%s' failed: ",
+                              l->blk_name, file);
+            continue;
+        }
+        info_report("CD-ROM %s: inserted '%s' (%u/%u)", l->blk_name, file,
+                    l->idx + 1, l->files->len);
+    }
+}
+
